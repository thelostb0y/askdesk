# ── 12-factor config: everything the platform needs comes from env ──────────
# Copy to .env and fill in. Nothing here is required for the offline test suite.

# Postgres with pgvector (Supabase: Settings → Database → connection string).
# Run db/schema.sql against it once before first ingest.
ASKDESK_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/askdesk

# LiteLLM model ids — any provider LiteLLM supports, swappable without code changes.
ASKDESK_CHAT_MODEL=anthropic/claude-sonnet-4-6
ASKDESK_EMBED_MODEL=openai/text-embedding-3-small
ASKDESK_EMBED_DIM=1536

# Provider keys (only the ones your chosen models need)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# VOYAGE_API_KEY=

# Observability (optional — platform runs without it)
SENTRY_DSN=

# Service
ASKDESK_API_KEY=change-me            # bearer token clients must send
ASKDESK_MAX_CRITIC_RETRIES=1
ASKDESK_TOP_K=6
